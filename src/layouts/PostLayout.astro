---
import BaseLayout from './BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import Comments from '../components/Comments.astro';

interface Props {
  frontmatter: {
    title: string;
    category: string;
    tag: string;
    date: string;
    readTime: string;
    description?: string;
    serie?: string;
    serieNum?: number;
    prev?: { title: string; slug: string };
    next?: { title: string; slug: string };
  };
  headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings = [] } = Astro.props;
const isTech = ['azure', 'ia', 'cloud', 'tech'].includes(frontmatter.tag);

// Open Graph
const ogImage = `/og-default.png`;
const badgeClass = isTech ? 'badge-tech' : 'badge-carreira';
const tocHeadings = headings.filter(h => h.depth === 2);
---

<BaseLayout
  title={`${frontmatter.title} — rfarias`}
  description={frontmatter.description || `${frontmatter.title} — artigo por Rafael Farias sobre ${frontmatter.category}.`}
  image={ogImage}
  type="article"
>
  <article class="container post-page">
    {frontmatter.serie && (
      <div class="serie-banner">
        <div class="serie-banner-left">
          <span class="serie-banner-icon">📚</span>
          <div>
            <div class="serie-banner-name">{frontmatter.serie}</div>
            <div class="serie-banner-num">Artigo {frontmatter.serieNum}</div>
          </div>
        </div>
        {frontmatter.serieSlug && (
          <a href={`/series/${frontmatter.serieSlug}`} class="serie-banner-link">
            Ver série completa →
          </a>
        )}
      </div>
    )}

    <div class="post-header">
      <span class:list={['badge', badgeClass]}>{frontmatter.category}</span>
      <span class="post-date">{frontmatter.date} · {frontmatter.readTime} de leitura</span>
    </div>

    <h1 class="post-main-title">{frontmatter.title}</h1>

    <div class:list={['post-body', { 'with-toc': isTech && tocHeadings.length > 0 }]}>
      {isTech && tocHeadings.length > 0 && (
        <aside class="toc">
          <p class="toc-label">Neste artigo</p>
          {tocHeadings.map((h, i) => (
            <a href={`#${h.slug}`} class:list={['toc-item', { first: i === 0 }]}>
              {h.text}
            </a>
          ))}
        </aside>
      )}

      <div class="prose">
        <slot />
      </div>
    </div>

    <Newsletter compact={true} />

    {(frontmatter.prev || frontmatter.next) && (
      <nav class="post-nav">
        {frontmatter.prev ? (
          <a href={`/posts/${frontmatter.prev.slug}`} class="post-nav-card prev-card">
            <span class="nav-direction">← Anterior</span>
            <span class="nav-title">{frontmatter.prev.title}</span>
          </a>
        ) : <span />}
        {frontmatter.next ? (
          <a href={`/posts/${frontmatter.next.slug}`} class="post-nav-card next-card">
            <span class="nav-direction">Próximo →</span>
            <span class="nav-title">{frontmatter.next.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}

    {frontmatter.serieSlug && (
      <div class="serie-bottom-cta">
        <a href={`/series/${frontmatter.serieSlug}`}>
          📚 Ver todos os artigos da série {frontmatter.serie} →
        </a>
      </div>
    )}

    <Comments title={frontmatter.title} />
  </article>
</BaseLayout>

<style>
  .post-page {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .serie-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6d28d9;
    background: #ede9fe;
    padding: 3px 10px;
    border-radius: 20px;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .post-main-title {
    font-size: 1.875rem;
    margin-bottom: 1.5rem;
    max-width: 720px;
  }

  .post-body {
    max-width: 820px;
  }

  .post-body.with-toc {
    display: flex;
    gap: 2.5rem;
  }

  .toc {
    min-width: 180px;
    position: sticky;
    top: 76px;
    align-self: flex-start;
    border-left: 2px solid var(--blue-light);
    padding-left: 1rem;
  }

  .toc-label {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    margin-bottom: 0.625rem;
  }

  .toc-item {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    line-height: 1.4;
    transition: color 0.15s;
  }

  .toc-item:hover, .toc-item.first {
    color: var(--blue);
  }

  .toc-item.first {
    font-weight: 600;
  }

  /* Serie banner */
  .serie-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ede9fe;
    border: 1px solid #c4b5fd;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    max-width: 680px;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .serie-banner-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .serie-banner-icon { font-size: 1.125rem; }
  .serie-banner-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: #6d28d9;
  }
  .serie-banner-num {
    font-size: 0.75rem;
    color: #7c3aed;
  }
  .serie-banner-link {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #6d28d9;
    white-space: nowrap;
  }
  .serie-banner-link:hover { text-decoration: underline; }

  /* Post nav */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    margin-top: 2.5rem;
    max-width: 680px;
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.15s, background 0.15s;
  }
  .post-nav-card:hover {
    border-color: var(--blue);
    background: var(--blue-light, #EBF3FF);
  }
  .next-card { text-align: right; }
  .nav-direction {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .nav-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--blue);
    line-height: 1.4;
  }

  .serie-bottom-cta {
    margin-top: 1rem;
    max-width: 680px;
    text-align: center;
  }
  .serie-bottom-cta a {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--blue);
  }
  .serie-bottom-cta a:hover { text-decoration: underline; }

  @media (max-width: 768px) {
    .post-body.with-toc {
      flex-direction: column;
    }

    .toc {
      position: static;
      border-left: none;
      border-bottom: 1px solid var(--border);
      padding-left: 0;
      padding-bottom: 1rem;
      margin-bottom: 1.5rem;
    }

    .post-main-title {
      font-size: 1.5rem;
    }
  }
</style>
