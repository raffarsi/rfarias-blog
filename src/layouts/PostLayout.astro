---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    category: string;
    tag: string;
    date: string;
    readTime: string;
    description?: string;
    serie?: string;
    serieNum?: number;
    prev?: { title: string; slug: string };
    next?: { title: string; slug: string };
  };
  headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings = [] } = Astro.props;
const isTech = ['azure', 'ia', 'cloud', 'tech'].includes(frontmatter.tag);
const badgeClass = isTech ? 'badge-tech' : 'badge-carreira';
const tocHeadings = headings.filter(h => h.depth === 2);
---

<BaseLayout title={`${frontmatter.title} — rfarias`} description={frontmatter.description}>
  <article class="container post-page">
    <div class="post-header">
      {frontmatter.serie && (
        <span class="serie-label">📚 {frontmatter.serie} · #{frontmatter.serieNum}</span>
      )}
      <span class:list={['badge', badgeClass]}>{frontmatter.category}</span>
      <span class="post-date">{frontmatter.date} · {frontmatter.readTime} de leitura</span>
    </div>

    <h1 class="post-main-title">{frontmatter.title}</h1>

    <div class:list={['post-body', { 'with-toc': isTech && tocHeadings.length > 0 }]}>
      {isTech && tocHeadings.length > 0 && (
        <aside class="toc">
          <p class="toc-label">Neste artigo</p>
          {tocHeadings.map((h, i) => (
            <a href={`#${h.slug}`} class:list={['toc-item', { first: i === 0 }]}>
              {h.text}
            </a>
          ))}
        </aside>
      )}

      <div class="prose">
        <slot />
      </div>
    </div>

    {(frontmatter.prev || frontmatter.next) && (
      <nav class="post-nav">
        {frontmatter.prev ? (
          <a href={`/posts/${frontmatter.prev.slug}`} class="post-nav-link">
            ← {frontmatter.prev.title}
          </a>
        ) : <span />}
        {frontmatter.next ? (
          <a href={`/posts/${frontmatter.next.slug}`} class="post-nav-link">
            {frontmatter.next.title} →
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .post-page {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .serie-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6d28d9;
    background: #ede9fe;
    padding: 3px 10px;
    border-radius: 20px;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .post-main-title {
    font-size: 1.875rem;
    margin-bottom: 1.5rem;
    max-width: 720px;
  }

  .post-body {
    max-width: 820px;
  }

  .post-body.with-toc {
    display: flex;
    gap: 2.5rem;
  }

  .toc {
    min-width: 180px;
    position: sticky;
    top: 76px;
    align-self: flex-start;
    border-left: 2px solid var(--blue-light);
    padding-left: 1rem;
  }

  .toc-label {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    margin-bottom: 0.625rem;
  }

  .toc-item {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    line-height: 1.4;
    transition: color 0.15s;
  }

  .toc-item:hover, .toc-item.first {
    color: var(--blue);
  }

  .toc-item.first {
    font-weight: 600;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    margin-top: 2.5rem;
    max-width: 680px;
  }

  .post-nav-link {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--blue);
    transition: opacity 0.15s;
  }

  .post-nav-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .post-body.with-toc {
      flex-direction: column;
    }

    .toc {
      position: static;
      border-left: none;
      border-bottom: 1px solid var(--border);
      padding-left: 0;
      padding-bottom: 1rem;
      margin-bottom: 1.5rem;
    }

    .post-main-title {
      font-size: 1.5rem;
    }
  }
</style>
