---
import BaseLayout from './BaseLayout.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { instante } from '../lib/agenda.mjs';
import { listarPublicados } from '../lib/areas.mjs';
import { trilhaDoArtigo } from '../lib/trilhas.mjs';


interface Props {
  frontmatter: {
    title: string;
    category: string;
    tag: string;
    date: string;
    readTime: string;
    description?: string;
    serie?: string;
    serieNum?: number;
    serieSlug?: string;
    prev?: { title: string; slug: string };
    next?: { title: string; slug: string };
  };
  headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings = [] } = Astro.props;

// Open Graph
const mvpSlugs = [];
const articleSlug = Astro.url.pathname.replace('/posts/', '').replace('/', '');
const hasOG = mvpSlugs.includes(articleSlug);
const ogImage = hasOG ? `/og/${articleSlug}.png` : `/og-default.png`;
// Imagem da prévia ao compartilhar o link (gerada no build em /og-artigos/); não aparece na página
const shareImage = `/og-artigos/${articleSlug}.png`;
const tocHeadings = headings.filter(h => h.depth === 2);
const temIndice = tocHeadings.length >= 2;
// Data de publicação em ISO para os dados estruturados (o frontmatter usa "15 Nov 2025")
const ms = instante(frontmatter.date, (frontmatter as any).hora);
const articleDate = Number.isFinite(ms) && ms > 0 ? new Date(ms).toISOString() : undefined;

// Trilha de leitura em que o artigo está (src/lib/trilhas.mjs), se estiver em alguma
const publicados = listarPublicados(import.meta.glob('../pages/posts/*.md', { eager: true }));
const naTrilha = trilhaDoArtigo(articleSlug, publicados);
const proximoNaTrilha = naTrilha ? naTrilha.passos[naTrilha.indice + 1] : undefined;
const temLateral = temIndice || !!naTrilha;
const rotuloSerie = frontmatter.serie ? `${frontmatter.serie}${frontmatter.serieNum ? ` · Artigo ${frontmatter.serieNum}` : ''}` : '';
---


<BaseLayout
  title={`${frontmatter.title} | rfarias`}
  description={frontmatter.description || `${frontmatter.title}, artigo por Rafael Farias sobre ${frontmatter.category}.`}
  image={shareImage}
  type="article"
  articleDate={articleDate}
  articleSection={frontmatter.category}
  headline={frontmatter.title}
>
  <article class="container post-page">
    {hasOG && (
      <div class="post-cover-image">
        <img src={ogImage} alt={frontmatter.title} loading="eager" />
      </div>
    )}
    <header class="post-cab">
      <div class="post-chips">
        {naTrilha && <a href="/#trilhas" class="chip chip-trilha">Trilha {naTrilha.trilha.nome}</a>}
        {naTrilha && <span class="post-passo">Passo {naTrilha.indice + 1} de {naTrilha.passos.length}</span>}
        {frontmatter.serie && frontmatter.serieSlug && <a href={`/series/${frontmatter.serieSlug}/`} class="chip chip-trilha">{rotuloSerie}</a>}
        {frontmatter.serie && !frontmatter.serieSlug && <span class="chip chip-trilha">{rotuloSerie}</span>}
        <span class="chip chip-cat">{frontmatter.category}</span>
      </div>
      <h1 class="post-main-title">{frontmatter.title}</h1>
      {frontmatter.description && <p class="post-lede">{frontmatter.description}</p>}
      <div class="post-autor-linha">
        <span class="autor-foto" aria-hidden="true"><img src="/images/rafael-farias-recorte.webp" alt="" width="44" height="44" /></span>
        <span class="autor-dados">
          <span class="autor-nome">Rafael Farias da Silva <span class="autor-titulo">· MVP Microsoft</span></span>
          <span class="post-date">{frontmatter.date} · {frontmatter.readTime} de leitura</span>
        </span>
      </div>
    </header>

    <div class:list={['post-body', { 'com-lateral': temLateral }]}>
      {temLateral && (
        <aside class="lateral">
          {naTrilha && (
            <nav class="lateral-trilha" aria-label={`Trilha ${naTrilha.trilha.nome}`}>
              <p class="lateral-rotulo">Trilha {naTrilha.trilha.nome}</p>
              <ol>
                {naTrilha.passos.map((p, i) => (
                  <li class:list={{ atual: i === naTrilha.indice, lido: i < naTrilha.indice }}>
                    <span class="lt-n" aria-hidden="true">{i + 1}</span>
                    {i === naTrilha.indice
                      ? <span aria-current="page">{p.titulo}</span>
                      : <a href={p.href}>{p.titulo}</a>}
                  </li>
                ))}
              </ol>
            </nav>
          )}
          {temIndice && (
            <nav class="toc" aria-label="Neste artigo">
              <p class="lateral-rotulo">Neste artigo</p>
              {tocHeadings.map((h) => (
                <a href={`#${h.slug}`} class="toc-item">{h.text}</a>
              ))}
            </nav>
          )}
        </aside>
      )}

      <div class="prose">
        <slot />
      </div>
    </div>

    

    {proximoNaTrilha && (
      <a href={proximoNaTrilha.href} class="proximo-trilha">
        <span class="pt-rotulo">Próximo na trilha · passo {naTrilha.indice + 2} de {naTrilha.passos.length}</span>
        <span class="pt-titulo">{proximoNaTrilha.titulo}</span>
      </a>
    )}

    <section class="autor-box" aria-label="Sobre o autor">
      <span class="autor-box-foto" aria-hidden="true"><img src="/images/rafael-farias-recorte.webp" alt="" width="64" height="64" loading="lazy" /></span>
      <div class="autor-box-texto">
        <p class="autor-box-nome">Rafael Farias da Silva</p>
        <p>MVP Microsoft e Microsoft Certified Trainer, engenheiro de software e professor no Senac Osasco. Escreve sobre Azure, Cloud e IA Generativa com casos reais.</p>
        <p class="autor-box-links"><a href="/sobre/">Sobre mim</a><a href="https://linkedin.com/in/rafael-farias-da-silva" target="_blank" rel="noopener">LinkedIn</a></p>
      </div>
    </section>

    {(frontmatter.prev || frontmatter.next) && (
      <nav class="post-nav">
        {frontmatter.prev ? (
          <a href={`/posts/${frontmatter.prev.slug}/`} class="post-nav-card prev-card">
            <span class="nav-direction">← Anterior</span>
            <span class="nav-title">{frontmatter.prev.title}</span>
          </a>
        ) : <span />}
        {frontmatter.next ? (
          <a href={`/posts/${frontmatter.next.slug}/`} class="post-nav-card next-card">
            <span class="nav-direction">Próximo →</span>
            <span class="nav-title">{frontmatter.next.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}

    {frontmatter.serieSlug && (
      <div class="serie-bottom-cta">
        <a href={`/series/${frontmatter.serieSlug}/`}>
          Ver todos os artigos da série {frontmatter.serie} →
        </a>
      </div>
    )}

    <RelatedPosts
      slug={articleSlug}
      tag={frontmatter.tag}
      excluir={[frontmatter.prev?.slug, frontmatter.next?.slug].filter(Boolean)}
    />
  </article>
</BaseLayout>

<style>
  .post-page { padding-top: 0; padding-bottom: 2rem; }

  /* Cabeçalho do artigo */
  .post-cab { max-width: 800px; padding: 2.5rem 0 2rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 1rem; }
  .post-chips { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; font-size: 0.875rem; }
  .chip { display: inline-flex; align-items: center; min-height: 28px; padding: 0 0.75rem; border-radius: 999px; font-weight: 600; font-size: 0.8125rem; }
  .chip-trilha { background: var(--blue-light); color: var(--blue); }
  a.chip-trilha:hover { text-decoration: underline; text-underline-offset: 3px; }
  .chip-cat { border: 1px solid var(--border); color: var(--text-muted); }
  .post-passo { color: var(--text-muted); }
  .post-main-title { font-size: 2.5rem; line-height: 1.15; letter-spacing: -0.02em; font-weight: 600; }
  .post-lede { font-size: 1.1875rem; line-height: 1.6; color: var(--text-muted); }
  .post-autor-linha { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.25rem; }
  .autor-foto, .autor-box-foto { flex-shrink: 0; border-radius: 50%; overflow: hidden; background: linear-gradient(160deg, var(--foto-from), var(--foto-to)); display: block; }
  .autor-foto { width: 44px; height: 44px; }
  .autor-foto img, .autor-box-foto img { width: 100%; height: 100%; object-fit: cover; object-position: center 12%; }
  .autor-dados { display: flex; flex-direction: column; gap: 2px; font-size: 0.875rem; }
  .autor-nome { font-weight: 600; }
  .autor-titulo { font-weight: 500; color: var(--blue); }
  .post-date { font-size: 0.875rem; color: var(--text-muted); }

  /* Corpo com coluna lateral */
  .post-body { max-width: 760px; }
  .post-body.com-lateral { max-width: none; display: grid; grid-template-columns: minmax(0, 720px) minmax(220px, 280px); gap: 4rem; justify-content: space-between; }
  .post-body.com-lateral .prose { grid-column: 1; grid-row: 1; max-width: 720px; min-width: 0; }
  .lateral { grid-column: 2; grid-row: 1; position: sticky; top: 84px; align-self: start; display: flex; flex-direction: column; gap: 2rem; max-height: calc(100vh - 100px); overflow-y: auto; }
  .lateral-rotulo { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.75rem; }
  .lateral-trilha { border: 1px solid var(--border); border-radius: 14px; padding: 1.125rem; background: var(--surface); }
  .lateral-trilha ol { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; padding: 0; margin: 0; }
  .lateral-trilha li { display: flex; gap: 0.625rem; align-items: flex-start; padding: 0.375rem 0; font-size: 0.875rem; line-height: 1.45; color: var(--text-muted); }
  .lateral-trilha li.atual { color: var(--text); font-weight: 600; }
  .lateral-trilha a { color: inherit; }
  .lateral-trilha a:hover { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
  .lt-n { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--border); font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .lateral-trilha li.lido .lt-n { border-color: var(--coral); }
  .lateral-trilha li.atual .lt-n { background: var(--blue); border-color: var(--blue); color: var(--on-blue); }
  .toc { display: flex; flex-direction: column; border-left: 1px solid var(--border); }
  .toc .lateral-rotulo { padding-left: 1rem; }
  .toc-item { display: block; padding: 0.375rem 0 0.375rem 1rem; margin-left: -1px; border-left: 2px solid transparent; font-size: 0.875rem; line-height: 1.45; color: var(--text-muted); }
  .toc-item:hover { color: var(--blue); border-left-color: var(--blue); }

  /* Próximo na trilha e caixa do autor */
  .proximo-trilha { max-width: 720px; margin-top: 3rem; display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem 1.75rem; border-radius: 16px; background: linear-gradient(135deg, var(--feature-from), var(--feature-to)); color: #fff8f3; }
  .proximo-trilha:hover { opacity: 0.95; }
  .pt-rotulo { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #a9d5ed; }
  .pt-titulo { font-family: var(--font-serif); font-size: 1.375rem; font-weight: 600; line-height: 1.3; }
  .autor-box { max-width: 720px; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; gap: 1rem; align-items: flex-start; }
  .autor-box-foto { width: 64px; height: 64px; }
  .autor-box-texto { display: flex; flex-direction: column; gap: 0.375rem; font-size: 0.9375rem; line-height: 1.6; color: var(--text-muted); }
  .autor-box-nome { font-weight: 600; font-size: 1rem; color: var(--text); }
  .autor-box-links { display: flex; gap: 1.25rem; font-weight: 600; }
  .autor-box-links a { color: var(--blue); }
  .autor-box-links a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Navegação anterior/próximo das séries */
  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; border-top: 1px solid var(--border); padding-top: 1.5rem; margin-top: 2.5rem; max-width: 720px; }
  .post-nav-card { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.875rem 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; transition: border-color 0.15s, background 0.15s; }
  .post-nav-card:hover { border-color: var(--blue); background: var(--blue-light); }
  .next-card { text-align: right; }
  .nav-direction { font-size: 0.6875rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .nav-title { font-size: 0.875rem; font-weight: 600; color: var(--blue); line-height: 1.4; }
  .serie-bottom-cta { margin-top: 1rem; max-width: 720px; text-align: center; }
  .serie-bottom-cta a { font-size: 0.875rem; font-weight: 600; color: var(--blue); }
  .serie-bottom-cta a:hover { text-decoration: underline; }

  .post-cover-image { margin-top: 2rem; border-radius: 12px; overflow: hidden; border: 1px solid var(--border); }
  .post-cover-image img { width: 100%; height: auto; display: block; }

  @media (max-width: 960px) {
    .post-body.com-lateral { display: flex; flex-direction: column-reverse; gap: 2rem; }
    .lateral { position: static; max-height: none; overflow: visible; }
    .toc { display: none; }
  }
  @media (max-width: 768px) {
    .post-cab { padding-top: 1.75rem; }
    .post-main-title { font-size: 1.75rem; }
    .post-lede { font-size: 1.0625rem; }
    .post-nav { grid-template-columns: 1fr; }
    .next-card { text-align: left; }
  }
</style>
