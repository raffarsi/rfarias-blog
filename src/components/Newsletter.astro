---
// Newsletter component — integração via Cloudflare Worker ou formulário simples
const { compact = false } = Astro.props;
---

<div class:list={['newsletter-wrap', { 'newsletter-compact': compact }]}>
  {!compact && (
    <div class="newsletter-header">
      <span class="newsletter-icon">📬</span>
      <div>
        <h3 class="newsletter-title">Receba novos artigos</h3>
        <p class="newsletter-desc">Sempre que publicar algo novo sobre Azure, Cloud ou IA, você recebe direto no e-mail. Sem spam, só conteúdo.</p>
      </div>
    </div>
  )}
  {compact && (
    <p class="newsletter-compact-label">📬 <strong>Gostou?</strong> Receba novos artigos por e-mail.</p>
  )}
  <form
    class="newsletter-form"
    id="newsletter-form"
    action="https://formspree.io/f/xpwznojz"
    method="POST"
  >
    <input
      type="email"
      name="email"
      placeholder="seu@email.com"
      required
      class="newsletter-input"
      autocomplete="email"
    />
    <button type="submit" class="newsletter-btn">
      Quero receber
    </button>
  </form>
  <p class="newsletter-privacy">Seus dados ficam só comigo. Descadastro fácil a qualquer momento.</p>
  <div class="newsletter-success hidden" id="newsletter-success">
    ✅ Cadastro feito! Você receberá o próximo artigo.
  </div>
</div>

<script is:inline>
  const form = document.getElementById('newsletter-form');
  const success = document.getElementById('newsletter-success');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const btn = form.querySelector('button');
      btn.disabled = true;
      btn.textContent = 'Enviando...';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.classList.add('hidden');
          success?.classList.remove('hidden');
        } else {
          btn.disabled = false;
          btn.textContent = 'Quero receber';
          alert('Erro ao cadastrar. Tente novamente.');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Quero receber';
      }
    });
  }
</script>

<style>
  .newsletter-wrap {
    background: linear-gradient(135deg, #0f1f3d 0%, #1a3a6b 100%);
    border-radius: 16px;
    padding: 2rem;
    color: #fff;
    margin: 2.5rem 0;
  }
  .newsletter-compact {
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }
  .newsletter-header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }
  .newsletter-icon { font-size: 2rem; flex-shrink: 0; }
  .newsletter-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
    color: #fff;
  }
  .newsletter-desc {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.75);
    line-height: 1.5;
    margin: 0;
  }
  .newsletter-compact-label {
    font-size: 0.9375rem;
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .newsletter-form {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
  }
  .newsletter-input {
    flex: 1;
    min-width: 200px;
    padding: 0.75rem 1rem;
    border: none;
    border-radius: 8px;
    font-size: 0.9375rem;
    background: rgba(255,255,255,0.12);
    color: #fff;
    outline: none;
    transition: background 0.15s;
  }
  .newsletter-input::placeholder { color: rgba(255,255,255,0.5); }
  .newsletter-input:focus { background: rgba(255,255,255,0.2); }
  .newsletter-btn {
    padding: 0.75rem 1.5rem;
    background: #1A56DB;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .newsletter-btn:hover { opacity: 0.9; }
  .newsletter-btn:disabled { opacity: 0.6; cursor: default; }
  .newsletter-privacy {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    margin: 0.75rem 0 0;
  }
  .newsletter-success {
    background: rgba(255,255,255,0.15);
    border-radius: 8px;
    padding: 0.875rem 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .hidden { display: none; }
</style>
