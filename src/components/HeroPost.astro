---
interface Props {
  title: string;
  slug: string;
  category: string;
  date: string;
  readTime: string;
  excerpt: string;
}

const { title, slug, category, date, readTime, excerpt } = Astro.props;
---

<a href={`/posts/${slug}`} class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <div class="hero-meta">
      <span class="hero-badge">{category}</span>
      <span class="hero-date">{date} · {readTime}</span>
    </div>

    <h2 class="hero-title">{title}</h2>

    <p class="hero-excerpt">{excerpt}</p>

    <span class="hero-cta">Ler artigo</span>
  </div>
</a>

<style>
  .hero {
    display: block;
    background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue) 100%);
    border-radius: 14px;
    padding: 2.25rem;
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    top: -30px;
    right: -30px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
  }

  .hero-badge {
    background: rgba(255, 255, 255, 0.15);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
  }

  .hero-date {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8125rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.875rem;
    max-width: 560px;
    color: #fff;
  }

  .hero-excerpt {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 520px;
  }

  .hero-cta {
    display: inline-block;
    background: var(--coral);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    transition: opacity 0.15s;
  }

  .hero:hover .hero-cta {
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 1.5rem;
    }

    .hero-title {
      font-size: 1.3rem;
    }
  }
</style>
