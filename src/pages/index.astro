---
import { instante } from '../lib/agenda.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { TRILHAS, CERTIFICACOES, passosDaTrilha } from '../lib/trilhas.mjs';

// Regra de publicacao agendada: um lugar so, em src/lib/agenda.mjs
const AGORA = Date.now();
const noAr = p => instante(p.frontmatter.date, p.frontmatter.hora) <= AGORA;

const allPosts = (await Astro.glob('./posts/*.md'))
  .filter(noAr)
  .map(p => ({
    slug: p.file.split('/').pop().replace(/\.md$/, ''),
    title: p.frontmatter.title,
    category: p.frontmatter.category,
    tag: p.frontmatter.tag,
    date: p.frontmatter.date,
    readTime: p.frontmatter.readTime,
    hora: p.frontmatter.hora,
    excerpt: p.frontmatter.excerpt || p.frontmatter.description,
  }))
  .sort((a, b) => instante(b.date, b.hora) - instante(a.date, a.hora));

const recentes = allPosts.slice(0, 6);
const contar = (tags) => allPosts.filter(p => tags.includes(p.tag)).length;

// Trilhas: uma lista só, em src/lib/trilhas.mjs (também usada na página de artigo)
const trilhas = [
  ...TRILHAS.map(t => ({ nome: t.nome, desc: t.desc, total: `${contar(t.tags)} artigos`, cta: t.cta, ctaHref: t.ctaHref, passos: passosDaTrilha(t, allPosts) })),
  { ...CERTIFICACOES, destaque: true },
];
---

<BaseLayout>
  <section class="topo">
    <div class="container topo-grid">
      <div class="topo-texto">
        <p class="selo">MVP Microsoft</p>
        <h1 class="topo-titulo">Azure, Cloud e IA Generativa com casos reais, sem enrolação.</h1>
        <p class="topo-sub">Sou Rafael Farias, MVP Microsoft e Microsoft Certified Trainer. Engenheiro de Software, professor no Senac Osasco e mestrando em Inteligência Artificial.</p>
        <div class="topo-acoes">
          <a href="#trilhas" class="btn btn-principal">Escolher uma trilha</a>
          <a href="/sobre/" class="btn btn-secundario">Sobre mim</a>
        </div>
      </div>
      <div class="topo-foto">
        <img src="/images/rafael-farias-recorte.webp" alt="Rafael Farias da Silva" width="800" height="800" />
      </div>
    </div>
  </section>

  <section class="numeros" aria-label="Em números">
    <div class="container numeros-grid">
      <div><strong>{allPosts.length}</strong><span>artigos publicados</span></div>
      <div><strong>500+</strong><span>alunos formados no Senac</span></div>
      <div><strong>90%+</strong><span>de aprovação em certificação Microsoft</span></div>
      <div><strong>17+</strong><span>anos em tecnologia</span></div>
    </div>
  </section>

  <section class="mvp" aria-label="MVP Microsoft">
    <div class="container mvp-inner">
      <img src="/images/mvp/microsoft-mvp-logo-fundo-escuro.svg" alt="Microsoft MVP, Most Valuable Professional" class="mvp-logo" width="173" height="60" />
      <p class="mvp-texto"><strong>Rafael Farias da Silva</strong>, MVP Microsoft. As opiniões publicadas aqui são minhas.</p>
    </div>
  </section>

  <section id="trilhas" class="container trilhas">
    <div class="trilhas-topo">
      <div>
        <h2>O que você precisa resolver no Azure?</h2>
        <p>Comece por uma trilha, com os artigos em ordem de leitura, ou busque direto.</p>
      </div>
      <form action="/artigos/" method="get" role="search" class="busca">
        <label for="home-q" class="sr-only">Buscar artigos</label>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input id="home-q" name="q" type="search" placeholder="Ex.: private endpoint, DNS" />
      </form>
    </div>
    <div class="trilhas-grid">
      {trilhas.map(t => (
        <article class:list={['trilha', { 'trilha-destaque': t.destaque }]}>
          <div class="trilha-cab">
            <div>
              <h3>{t.nome}</h3>
              <p>{t.desc}</p>
            </div>
            <span class="trilha-total">{t.total}</span>
          </div>
          <ol class="trilha-passos">
            {t.passos.map((p, i) => (
              <li><span class="passo-n" aria-hidden="true">{i + 1}</span><a href={p.href}>{p.titulo}</a></li>
            ))}
          </ol>
          <a href={t.ctaHref} class="trilha-cta">{t.cta} →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="container recentes">
    <div class="recentes-topo">
      <h2>Publicados recentemente</h2>
      <a href="/artigos/">Ver os {allPosts.length} artigos →</a>
    </div>
    <div class="recentes-grid">
      {recentes.map(post => <PostCard {...post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Topo: autor em destaque */
  .topo { background: var(--surface-alt); border-bottom: 1px solid var(--border); }
  .topo-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3rem; align-items: center; padding-top: 3rem; padding-bottom: 3.5rem; }
  .topo-texto { display: flex; flex-direction: column; gap: 1.25rem; }
  .selo { align-self: flex-start; font-size: 0.8125rem; font-weight: 600; color: var(--blue); background: var(--blue-light); padding: 0.375rem 0.875rem; border-radius: 999px; }
  .topo-titulo { font-size: 2.75rem; line-height: 1.12; letter-spacing: -0.02em; font-weight: 600; }
  .topo-sub { font-size: 1.125rem; line-height: 1.6; color: var(--text-muted); max-width: 34rem; }
  .topo-acoes { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btn { min-height: 48px; padding: 0 1.5rem; border-radius: 10px; font-weight: 600; font-size: 0.9375rem; display: inline-flex; align-items: center; }
  .btn-principal { background: var(--blue); color: var(--on-blue); }
  .btn-principal:hover { opacity: 0.92; }
  .btn-secundario { border: 1px solid var(--border); background: var(--surface); color: var(--text); }
  .btn-secundario:hover { border-color: var(--blue); }
  .topo-foto { background: linear-gradient(160deg, var(--foto-from), var(--foto-to)); border-radius: 20px; overflow: hidden; aspect-ratio: 4 / 5; display: flex; align-items: flex-end; justify-content: center; }
  .topo-foto img { width: 125%; max-width: none; height: auto; display: block; }

  /* Números */
  .numeros { border-bottom: 1px solid var(--border); }
  .numeros-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; padding-top: 2rem; padding-bottom: 2rem; }
  .numeros-grid div { display: flex; flex-direction: column; gap: 0.25rem; }
  .numeros-grid strong { font-family: var(--font-serif); font-size: 2.25rem; font-weight: 700; line-height: 1.1; }
  .numeros-grid span { font-size: 0.875rem; color: var(--text-muted); }

  /* Faixa MVP: logo oficial claro direto sobre o azul escuro oficial do programa */
  .mvp { background: var(--mvp-band); }
  .mvp-inner { display: flex; align-items: center; gap: 2rem; padding-top: 1.75rem; padding-bottom: 1.75rem; flex-wrap: wrap; }
  .mvp-logo { height: 60px; width: auto; flex-shrink: 0; }
  .mvp-texto { color: #c6d3e6; font-size: 0.9375rem; line-height: 1.6; flex: 1; min-width: 240px; }
  .mvp-texto strong { color: #fff8f3; font-size: 1.125rem; }

  /* Trilhas */
  .trilhas { padding-top: 4rem; padding-bottom: 1rem; }
  .trilhas-topo { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .trilhas-topo h2 { font-size: 2rem; line-height: 1.2; font-weight: 600; margin-bottom: 0.5rem; }
  .trilhas-topo p { color: var(--text-muted); }
  .busca { flex: 0 1 400px; min-height: 52px; display: flex; align-items: center; gap: 0.75rem; padding: 0 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; color: var(--text-muted); }
  .busca:focus-within { border-color: var(--blue); }
  .busca input { flex: 1; min-width: 0; border: 0; outline: none; background: transparent; color: var(--text); font: inherit; font-size: 1rem; }
  .trilhas-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .trilha { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; gap: 1.125rem; }
  .trilha-destaque { background: var(--surface-alt); }
  .trilha-cab { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .trilha-cab h3 { font-family: var(--font-sans); font-size: 1.25rem; font-weight: 700; margin-bottom: 0.25rem; }
  .trilha-cab p { font-size: 0.875rem; color: var(--text-muted); }
  .trilha-total { flex-shrink: 0; font-size: 0.8125rem; font-weight: 600; color: var(--blue); background: var(--blue-light); padding: 0.25rem 0.625rem; border-radius: 999px; }
  .trilha-passos { list-style: none; display: flex; flex-direction: column; }
  .trilha-passos li { display: flex; gap: 0.875rem; align-items: flex-start; padding: 0.75rem 0; border-top: 1px solid var(--border); }
  .passo-n { flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--coral); color: var(--text); font-size: 0.8125rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .trilha-passos a { font-size: 0.9375rem; line-height: 1.45; padding-top: 2px; }
  .trilha-passos a:hover, .trilha-cta:hover, .recentes-topo a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .trilha-cta { margin-top: auto; font-size: 0.9375rem; font-weight: 600; color: var(--blue); }

  /* Recentes */
  .recentes { padding-top: 3rem; padding-bottom: 4rem; }
  .recentes-topo { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .recentes-topo h2 { font-size: 1.625rem; font-weight: 600; }
  .recentes-topo a { font-weight: 600; color: var(--blue); }
  .recentes-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }

  @media (max-width: 900px) {
    .topo-grid { grid-template-columns: 1fr; gap: 2rem; padding-top: 2rem; padding-bottom: 2.5rem; }
    .topo-titulo { font-size: 2rem; }
    .topo-foto { max-width: 320px; aspect-ratio: 1 / 1; }
    .topo-foto img { width: 100%; } /* no quadrado a foto inteira cabe; com 125% a cabeça era cortada */
    .numeros-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
    .trilhas-grid, .recentes-grid { grid-template-columns: 1fr; }
    .trilhas { padding-top: 3rem; }
    .trilhas-topo h2 { font-size: 1.625rem; }
    .busca { flex: 1 1 100%; }
  }
</style>
