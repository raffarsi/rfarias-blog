---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPost from '../components/HeroPost.astro';
import PostCard from '../components/PostCard.astro';

const mvpSlugs = new Set([]);

const MESES = { Jan:1, Fev:2, Mar:3, Abr:4, Mai:5, Jun:6, Jul:7, Ago:8, Set:9, Out:10, Nov:11, Dez:12 };
const HORA_PADRAO = '10:00';   // artigo entra no ar as 10h de Brasilia, junto com o post do LinkedIn

// "24 Set 2026" + "10:00" -> instante em UTC, respeitando o fuso de Sao Paulo
function instante(dataPt, hora = HORA_PADRAO) {
  const p = String(dataPt || '').trim().split(' ');
  if (p.length < 3) return 0;
  const [dia, mes, ano] = [Number(p[0]), MESES[p[1]] || 1, Number(p[2])];
  const [h, min] = String(hora).split(':').map(Number);
  const palpite = Date.UTC(ano, mes - 1, dia, h, min || 0);
  // descobre o offset real de Sao Paulo naquela data (imune a horario de verao)
  const local = new Date(palpite).toLocaleString('sv-SE', { timeZone: 'America/Sao_Paulo' });
  const desvio = Date.parse(local.replace(' ', 'T') + 'Z') - palpite;
  return palpite - desvio;
}

const AGORA = Date.now();
const noAr = p => instante(p.frontmatter.date, p.frontmatter.hora) <= AGORA;

const allPosts = (await Astro.glob('./posts/*.md'))
  .filter(noAr)
  .map(p => ({
    slug: p.file.split('/').pop().replace(/\.md$/, ''),
    title: p.frontmatter.title,
    category: p.frontmatter.category,
    tag: p.frontmatter.tag,
    date: p.frontmatter.date,
    readTime: p.frontmatter.readTime,
    hora: p.frontmatter.hora,
    excerpt: p.frontmatter.excerpt || p.frontmatter.description,
  }))
  .sort((a, b) => instante(b.date, b.hora) - instante(a.date, a.hora));

const hero = allPosts[0];
const grid = allPosts.slice(1, 7); // mostra 6 posts mais recentes no grid

// Contadores para filtros
const counts = {
  todos:          allPosts.length,
  'ia-generativa':allPosts.filter(p => p.tag === 'ia-generativa').length,
  networking:     allPosts.filter(p => p.tag === 'networking').length,
  iam:            allPosts.filter(p => p.tag === 'iam').length,
  seguranca:      allPosts.filter(p => p.tag === 'seguranca').length,
  infra:          allPosts.filter(p => p.tag === 'infra').length,
  finops:         allPosts.filter(p => p.tag === 'finops').length,
  docencia:       allPosts.filter(p => p.tag === 'docencia').length,
  carreira:       allPosts.filter(p => p.tag === 'carreira').length,
};
---

<BaseLayout>
  <div class="container home">

    <!-- Hero pessoal -->
    <div class="personal-hero">
      <div class="personal-hero-left">
        <img src="/images/rafael-farias.jpg" alt="Rafael Farias da Silva" class="personal-avatar" />
      </div>
      <div class="personal-hero-right">
        <h1 class="personal-name">Rafael Farias da Silva</h1>
        <p class="personal-bio">
          Software Engineer &amp; IT Auditor no Bradesco com 17+ anos de experiência.
          Professor no Senac Osasco, palestrante em eventos de tecnologia e mestrando em IA.
          Aqui escrevo sobre <strong>Azure, Cloud e IA Generativa</strong>, com casos reais, sem enrolação.
        </p>
        <div class="personal-badges">
          <span class="pb">🏢 17+ anos em TI</span>
          <span class="pb">🎓 Professor Senac</span>
          <span class="pb">🎤 Palestrante</span>
          <span class="pb">📚 Mestrando em IA</span>
        </div>
        <div class="personal-links">
          <a href="https://linkedin.com/in/rafael-farias-da-silva" target="_blank" rel="noopener" class="pl-link pl-linkedin">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a href="https://instagram.com/rafael.farias.s" target="_blank" rel="noopener" class="pl-link pl-ig">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            @rafael.farias.s
          </a>
          <a href="/sobre" class="pl-link pl-sobre">Saiba mais →</a>
        </div>
      </div>
    </div>

    <section class="hero-section">
      <HeroPost
        title={hero.title}
        slug={hero.slug}
        category={hero.category}
        date={hero.date}
        readTime={hero.readTime}
        excerpt={hero.excerpt}
      />
    </section>

    <!-- Banner Treinamentos -->
    <a href="/treinamentos" class="training-banner">
      <div class="training-banner-content">
        <div class="training-badge">🎮 Plataforma Gamificada</div>
        <h3>Treinamentos com simulados, XP, ranking e conquistas</h3>
        <p>Prepare-se para certificações Azure e domine MS Project com banco de questões, jogos e laboratórios práticos, tudo integrado ao blog.</p>
        <span class="training-cta">Acessar treinamentos →</span>
      </div>
      <div class="training-stats-bar">
        <span>📝 400+ questões</span>
        <span>🧪 28 labs</span>
        <span>🏅 76 conquistas</span>
        <span>🏆 Ranking entre alunos</span>
      </div>
    </a>

    <h2 class="section-title">Artigos recentes</h2>

    <div class="filters">
      <a href="/artigos" class="filter-btn active">Todos <span class="filter-count">{counts.todos}</span></a>
      <a href="/artigos?cat=ia-generativa" class="filter-btn">IA Generativa <span class="filter-count">{counts['ia-generativa']}</span></a>
      <a href="/artigos?cat=networking" class="filter-btn">Networking <span class="filter-count">{counts.networking}</span></a>
      <a href="/artigos?cat=iam" class="filter-btn">IAM <span class="filter-count">{counts.iam}</span></a>
      <a href="/artigos?cat=seguranca" class="filter-btn">Segurança <span class="filter-count">{counts.seguranca}</span></a>
      <a href="/artigos?cat=infra" class="filter-btn">Infra <span class="filter-count">{counts.infra}</span></a>
      <a href="/artigos?cat=finops" class="filter-btn">FinOps <span class="filter-count">{counts.finops}</span></a>
      <a href="/artigos?cat=docencia" class="filter-btn">Docência <span class="filter-count">{counts.docencia}</span></a>
      <a href="/artigos?cat=carreira" class="filter-btn">Carreira <span class="filter-count">{counts.carreira}</span></a>
    </div>

    <!-- Carrossel -->
    <div class="carousel-wrapper">
      <button class="carousel-btn prev" id="prevBtn" aria-label="Anterior">‹</button>
      <div class="carousel-track-outer">
        <div class="carousel-track" id="carouselTrack">
          {allPosts.map(post => (
            <div class="carousel-card">
              <PostCard {...post} coverImage={mvpSlugs.has(post.slug) ? `/og/${post.slug}.png` : undefined} />
            </div>
          ))}
        </div>
      </div>
      <button class="carousel-btn next" id="nextBtn" aria-label="Próximo">›</button>
    </div>

    <div class="carousel-dots" id="carouselDots"></div>

    

    <div class="ver-todos">
      <a href="/artigos">Ver todos os {counts.todos} artigos →</a>
    </div>

  </div>
</BaseLayout>

<script is:inline>
  const track = document.getElementById('carouselTrack');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const dotsContainer = document.getElementById('carouselDots');

  function getVisible() {
    return window.innerWidth >= 1024 ? 3 : window.innerWidth >= 640 ? 2 : 1;
  }

  let current = 0;
  const cards = track.querySelectorAll('.carousel-card');
  const total = cards.length;

  function maxIndex() { return total - getVisible(); }

  function buildDots() {
    dotsContainer.innerHTML = '';
    const pages = maxIndex() + 1;
    for (let i = 0; i <= Math.min(pages - 1, 8); i++) {
      const dot = document.createElement('button');
      dot.className = 'carousel-dot' + (i === 0 ? ' active' : '');
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    }
  }

  function updateDots() {
    const dots = dotsContainer.querySelectorAll('.carousel-dot');
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }

  function goTo(index) {
    current = Math.max(0, Math.min(index, maxIndex()));
    const cardWidth = cards[0].offsetWidth + 20; // gap
    track.style.transform = `translateX(-${current * cardWidth}px)`;
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current >= maxIndex();
    updateDots();
  }

  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));

  buildDots();
  goTo(0);

  window.addEventListener('resize', () => { buildDots(); goTo(Math.min(current, maxIndex())); });

  // Touch/swipe
  let startX = 0;
  track.addEventListener('touchstart', e => startX = e.touches[0].clientX);
  track.addEventListener('touchend', e => {
    const diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) diff > 0 ? goTo(current + 1) : goTo(current - 1);
  });
</script>

<style>
  .home { padding-top: 2rem; padding-bottom: 2rem; }

  /* Hero pessoal */
  .personal-hero {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
    margin-bottom: 1.75rem;
  }
  .personal-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 3px solid var(--blue-light, #EBF3FF);
    flex-shrink: 0;
  }
  .personal-name {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }
  .personal-bio {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 0.875rem;
    max-width: 560px;
  }
  .personal-bio strong { color: var(--text); }
  .personal-badges {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-bottom: 0.875rem;
  }
  .pb {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    background: var(--blue-light, #EBF3FF);
    color: var(--blue);
    white-space: nowrap;
  }
  .personal-links {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .pl-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 8px;
    transition: all 0.15s;
  }
  .pl-linkedin { background: #0077b5; color: #fff; }
  .pl-linkedin:hover { opacity: 0.9; }
  .pl-ig { background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); color: #fff; }
  .pl-ig:hover { opacity: 0.9; }
  .pl-sobre { color: var(--blue); border: 1px solid var(--blue); }
  .pl-sobre:hover { background: var(--blue); color: #fff; }

  @media (max-width: 580px) {
    .personal-hero { flex-direction: column; gap: 1rem; }
    .personal-avatar { width: 72px; height: 72px; }
    .personal-name { font-size: 1.125rem; }
  }

  .hero-section { margin-bottom: 1.5rem; }

  .training-banner {
    display: block;
    background: linear-gradient(135deg, #0f3285 0%, #1a56db 60%, #3b73e8 100%);
    border-radius: 14px;
    padding: 2rem;
    color: #fff;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }
  .training-banner:hover { box-shadow: 0 6px 24px rgba(26, 86, 219, 0.2); }
  .training-badge { display: inline-block; background: rgba(255,255,255,0.15); font-size: 0.75rem; font-weight: 600; padding: 4px 12px; border-radius: 20px; margin-bottom: 0.75rem; }
  .training-banner h3 { font-family: var(--font-serif); font-size: 1.375rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem; max-width: 540px; }
  .training-banner-content p { font-size: 0.875rem; color: rgba(255,255,255,0.8); line-height: 1.6; margin-bottom: 1rem; max-width: 520px; }
  .training-cta { font-size: 0.875rem; font-weight: 600; color: #fff; background: var(--coral); padding: 0.5rem 1.25rem; border-radius: 8px; display: inline-block; }
  .training-stats-bar { display: flex; gap: 1.5rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.15); flex-wrap: wrap; }
  .training-stats-bar span { font-size: 0.75rem; color: rgba(255,255,255,0.7); white-space: nowrap; }

  .section-title { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 700; color: var(--text); margin-bottom: 1rem; }

  .filters { display: flex; gap: 0.375rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .filter-btn {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.8125rem; font-weight: 500; font-family: var(--font-sans);
    padding: 0.375rem 0.875rem; border-radius: 20px;
    border: 1px solid var(--border); color: var(--text-muted);
    transition: all 0.15s;
  }
  .filter-btn:hover { border-color: var(--blue); color: var(--blue); }
  .filter-btn.active { background: var(--blue); color: #fff; border-color: var(--blue); }
  .filter-count { background: rgba(0,0,0,0.08); font-size: 0.6875rem; font-weight: 700; padding: 1px 6px; border-radius: 20px; }
  .filter-btn.active .filter-count { background: rgba(255,255,255,0.25); }

  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem; }

  .ver-todos { text-align: center; margin-top: 1.5rem; }
  .ver-todos a { font-size: 0.875rem; font-weight: 600; color: var(--blue); }

  /* Carrossel */
  .carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .carousel-track-outer {
    flex: 1;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: 1.25rem;
    transition: transform 0.35s ease;
  }

  .carousel-card {
    flex: 0 0 calc((100% - 2 * 1.25rem) / 3);
    min-width: 0;
  }

  .carousel-btn {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 1.375rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text);
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-btn:hover:not(:disabled) {
    border-color: var(--blue);
    color: var(--blue);
    background: var(--blue-light);
  }

  .carousel-btn:disabled { opacity: 0.3; cursor: default; }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.375rem;
    margin-top: 1rem;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--border);
    cursor: pointer;
    transition: background 0.15s, transform 0.15s;
    padding: 0;
  }

  .carousel-dot.active {
    background: var(--blue);
    transform: scale(1.25);
  }

  @media (max-width: 1023px) {
    .carousel-card { flex: 0 0 calc((100% - 1.25rem) / 2); }
  }

  @media (max-width: 639px) {
    .carousel-card { flex: 0 0 100%; }
    .carousel-btn { width: 32px; height: 32px; font-size: 1.125rem; }
  }
</style>
