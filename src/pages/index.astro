---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPost from '../components/HeroPost.astro';
import PostCard from '../components/PostCard.astro';

const posts = [
  {
    slug: 'private-endpoints-azure',
    title: 'Como configurar Private Endpoints no Azure sem perder o acesso ao portal',
    category: 'Azure',
    tag: 'azure' as const,
    date: '27 Ago 2026',
    readTime: '8 min',
    excerpt: 'Nesse post eu mostro como configurei Private Endpoints em produção e o erro que quase me deixou sem acesso ao próprio recurso. Passo a passo com as armadilhas que a documentação não conta.',
  },
  {
    slug: 'aula-ms-project',
    title: 'O que aprendi dando aula de MS Project pra quem nunca viu gestão de projetos',
    category: 'Carreira',
    tag: 'docencia' as const,
    date: '23 Ago 2026',
    readTime: '5 min',
    excerpt: 'Dar aula pra quem está começando me obrigou a repensar tudo que eu achava óbvio. Compartilho aqui os ajustes que fiz no plano de aula depois da primeira semana.',
  },
  {
    slug: 'azure-ai-foundry',
    title: 'Azure AI Foundry: criando seu primeiro projeto de IA Generativa',
    category: 'IA',
    tag: 'ia' as const,
    date: '20 Ago 2026',
    readTime: '12 min',
    excerpt: 'Um guia prático de como usei o Azure AI Foundry para montar uma prova de conceito de chatbot com RAG no ambiente corporativo.',
  },
  {
    slug: '17-anos-mesma-empresa',
    title: '17 anos na mesma empresa — o que me fez ficar (e o que quase me fez sair)',
    category: 'Carreira',
    tag: 'carreira' as const,
    date: '16 Ago 2026',
    readTime: '6 min',
    excerpt: 'Longevidade em uma empresa não é inércia. Nesse texto, conto as decisões conscientes que tomei em cada fase e o que me manteve motivado.',
  },
  {
    slug: 'nsg-vs-asg',
    title: 'Network Security Groups vs Application Security Groups: quando usar cada um',
    category: 'Azure',
    tag: 'azure' as const,
    date: '13 Ago 2026',
    readTime: '10 min',
    excerpt: 'NSG e ASG parecem redundantes, mas resolvem problemas diferentes. Mostro aqui os cenários reais onde cada um brilha.',
  },
  {
    slug: 'simulado-gamificado-az900',
    title: 'Como montei um simulado gamificado de AZ-900 para meus alunos',
    category: 'Carreira',
    tag: 'docencia' as const,
    date: '9 Ago 2026',
    readTime: '7 min',
    excerpt: 'Criei uma plataforma com banco de questões, XP, ranking e conquistas. Nesse post, mostro o processo e o impacto na turma.',
  },
];

const hero = posts[0];
const grid = posts.slice(1);
---

<BaseLayout>
  <div class="container home">

    <!-- Credenciais -->
    <div class="credentials">
      <div class="cred-item">🏢 <span class="cred-number">17+ anos</span> em tecnologia</div>
      <div class="cred-sep"></div>
      <div class="cred-item">🎓 <span class="cred-number">Professor</span> Senac Osasco</div>
      <div class="cred-sep"></div>
      <div class="cred-item">🎤 <span class="cred-number">Palestrante</span> MVPConf</div>
      <div class="cred-sep"></div>
      <div class="cred-item">📚 <span class="cred-number">Mestrando</span> em IA</div>
    </div>

    <section class="hero-section">
      <HeroPost
        title={hero.title}
        slug={hero.slug}
        category={hero.category}
        date={hero.date}
        readTime={hero.readTime}
        excerpt={hero.excerpt}
      />
    </section>

    <!-- Banner Treinamentos -->
    <a href="/treinamentos" class="training-banner">
      <div class="training-banner-content">
        <div class="training-badge">🎮 Plataforma Gamificada</div>
        <h3>Treinamentos com simulados, XP, ranking e conquistas</h3>
        <p>Prepare-se para certificações Azure e domine MS Project com banco de questões, jogos e laboratórios práticos — tudo integrado ao blog.</p>
        <span class="training-cta">Acessar treinamentos →</span>
      </div>
      <div class="training-stats-bar">
        <span>📝 400+ questões</span>
        <span>🧪 28 labs</span>
        <span>🏅 76 conquistas</span>
        <span>🏆 Ranking entre alunos</span>
      </div>
    </a>

    <h2 class="section-title">Artigos recentes</h2>

    <div class="filters">
      <a href="/artigos" class="filter-btn">Todos</a>
      <a href="/artigos" class="filter-btn">Tecnologia</a>
      <a href="/artigos" class="filter-btn">Carreira</a>
    </div>

    <section class="post-grid">
      {grid.map(post => (
        <PostCard {...post} />
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .hero-section {
    margin-bottom: 1.5rem;
  }

  /* Credentials bar */
  .credentials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .cred-item {
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .cred-number {
    font-weight: 700;
    color: var(--blue);
  }

  .cred-sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border);
    flex-shrink: 0;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }

  /* Training banner */
  .training-banner {
    display: block;
    background: linear-gradient(135deg, #0f3285 0%, #1a56db 60%, #3b73e8 100%);
    border-radius: 14px;
    padding: 2rem;
    color: #fff;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }

  .training-banner:hover {
    box-shadow: 0 6px 24px rgba(26, 86, 219, 0.2);
  }

  .training-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 0.75rem;
    backdrop-filter: blur(4px);
  }

  .training-banner h3 {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
    max-width: 540px;
  }

  .training-banner-content p {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 1rem;
    max-width: 520px;
  }

  .training-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: #fff;
    background: var(--coral);
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    display: inline-block;
  }

  .training-stats-bar {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    flex-wrap: wrap;
  }

  .training-stats-bar span {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    white-space: nowrap;
  }

  .filters {
    display: flex;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
  }

  .filter-btn {
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.375rem 1rem;
    border-radius: 20px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: all 0.15s;
  }

  .filter-btn:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .filter-btn.active {
    background: var(--blue);
    color: #fff;
    border-color: var(--blue);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
