---

<BaseLayout>
  <div class="container home">

    <!-- Credenciais -->
    <div class="credentials">
      <img src="/images/rafael-farias.jpg" alt="Rafael Farias da Silva" class="cred-avatar" />
      <div class="cred-item">🏢 <span class="cred-number">17+ anos</span> em tecnologia</div>
      <div class="cred-sep"></div>
      <div class="cred-item">🎓 <span class="cred-number">Professor</span> Senac Osasco</div>
      <div class="cred-sep"></div>
      <div class="cred-item">🎤 <span class="cred-number">Palestrante</span> MVPConf</div>
      <div class="cred-sep"></div>
      <div class="cred-item">📚 <span class="cred-number">Mestrando</span> em IA</div>
    </div>

    <section class="hero-section">
      <HeroPost
        title={hero.title}
        slug={hero.slug}
        category={hero.category}
        date={hero.date}
        readTime={hero.readTime}
        excerpt={hero.excerpt}
      />
    </section>

    <!-- Banner Treinamentos -->
    <a href="/treinamentos" class="training-banner">
      <div class="training-banner-content">
        <div class="training-badge">🎮 Plataforma Gamificada</div>
        <h3>Treinamentos com simulados, XP, ranking e conquistas</h3>
        <p>Prepare-se para certificações Azure e domine MS Project com banco de questões, jogos e laboratórios práticos — tudo integrado ao blog.</p>
        <span class="training-cta">Acessar treinamentos →</span>
      </div>
      <div class="training-stats-bar">
        <span>📝 400+ questões</span>
        <span>🧪 28 labs</span>
        <span>🏅 76 conquistas</span>
        <span>🏆 Ranking entre alunos</span>
      </div>
    </a>

    <h2 class="section-title">Artigos recentes</h2>

    <div class="filters">
      <a href="/artigos" class="filter-btn active">Todos <span class="filter-count">{counts.todos}</span></a>
      <a href="/artigos" class="filter-btn">Azure <span class="filter-count">{counts.azure}</span></a>
      <a href="/artigos" class="filter-btn">IA <span class="filter-count">{counts.ia}</span></a>
      <a href="/artigos" class="filter-btn">Docência <span class="filter-count">{counts.docencia}</span></a>
      <a href="/artigos" class="filter-btn">Carreira <span class="filter-count">{counts.carreira}</span></a>
    </div>

    <!-- Carrossel -->
    <div class="carousel-wrapper">
      <button class="carousel-btn prev" id="prevBtn" aria-label="Anterior">‹</button>
      <div class="carousel-track-outer">
        <div class="carousel-track" id="carouselTrack">
          {allPosts.map(post => (
            <div class="carousel-card">
              <PostCard {...post} />
            </div>
          ))}
        </div>
      </div>
      <button class="carousel-btn next" id="nextBtn" aria-label="Próximo">›</button>
    </div>

    <div class="carousel-dots" id="carouselDots"></div>

    <div class="ver-todos">
      <a href="/artigos">Ver todos os {counts.todos} artigos →</a>
    </div>

  </div>
</BaseLayout>

<script is:inline>
  const track = document.getElementById('carouselTrack');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const dotsContainer = document.getElementById('carouselDots');

  function getVisible() {
    return window.innerWidth >= 1024 ? 3 : window.innerWidth >= 640 ? 2 : 1;
  }

  let current = 0;
  const cards = track.querySelectorAll('.carousel-card');
  const total = cards.length;

  function maxIndex() { return total - getVisible(); }

  function buildDots() {
    dotsContainer.innerHTML = '';
    const pages = maxIndex() + 1;
    for (let i = 0; i <= Math.min(pages - 1, 8); i++) {
      const dot = document.createElement('button');
      dot.className = 'carousel-dot' + (i === 0 ? ' active' : '');
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    }
  }

  function updateDots() {
    const dots = dotsContainer.querySelectorAll('.carousel-dot');
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }

  function goTo(index) {
    current = Math.max(0, Math.min(index, maxIndex()));
    const cardWidth = cards[0].offsetWidth + 20; // gap
    track.style.transform = `translateX(-${current * cardWidth}px)`;
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current >= maxIndex();
    updateDots();
  }

  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));

  buildDots();
  goTo(0);

  window.addEventListener('resize', () => { buildDots(); goTo(Math.min(current, maxIndex())); });

  // Touch/swipe
  let startX = 0;
  track.addEventListener('touchstart', e => startX = e.touches[0].clientX);
  track.addEventListener('touchend', e => {
    const diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) diff > 0 ? goTo(current + 1) : goTo(current - 1);
  });
</script>

<style>
  .home { padding-top: 2rem; padding-bottom: 2rem; }

  .credentials {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    margin-bottom: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    flex-wrap: wrap;
  }
  .cred-avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; object-position: center top; border: 2px solid var(--blue-light); flex-shrink: 0; }
  .cred-item { font-size: 0.8125rem; color: var(--text-muted); white-space: nowrap; }
  .cred-number { font-weight: 700; color: var(--blue); }
  .cred-sep { width: 4px; height: 4px; border-radius: 50%; background: var(--border); flex-shrink: 0; }

  .hero-section { margin-bottom: 1.5rem; }

  .training-banner {
    display: block;
    background: linear-gradient(135deg, #0f3285 0%, #1a56db 60%, #3b73e8 100%);
    border-radius: 14px;
    padding: 2rem;
    color: #fff;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }
  .training-banner:hover { box-shadow: 0 6px 24px rgba(26, 86, 219, 0.2); }
  .training-badge { display: inline-block; background: rgba(255,255,255,0.15); font-size: 0.75rem; font-weight: 600; padding: 4px 12px; border-radius: 20px; margin-bottom: 0.75rem; }
  .training-banner h3 { font-family: var(--font-serif); font-size: 1.375rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem; max-width: 540px; }
  .training-banner-content p { font-size: 0.875rem; color: rgba(255,255,255,0.8); line-height: 1.6; margin-bottom: 1rem; max-width: 520px; }
  .training-cta { font-size: 0.875rem; font-weight: 600; color: #fff; background: var(--coral); padding: 0.5rem 1.25rem; border-radius: 8px; display: inline-block; }
  .training-stats-bar { display: flex; gap: 1.5rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.15); flex-wrap: wrap; }
  .training-stats-bar span { font-size: 0.75rem; color: rgba(255,255,255,0.7); white-space: nowrap; }

  .section-title { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 700; color: var(--text); margin-bottom: 1rem; }

  .filters { display: flex; gap: 0.375rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .filter-btn {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.8125rem; font-weight: 500; font-family: var(--font-sans);
    padding: 0.375rem 0.875rem; border-radius: 20px;
    border: 1px solid var(--border); color: var(--text-muted);
    transition: all 0.15s;
  }
  .filter-btn:hover { border-color: var(--blue); color: var(--blue); }
  .filter-btn.active { background: var(--blue); color: #fff; border-color: var(--blue); }
  .filter-count { background: rgba(0,0,0,0.08); font-size: 0.6875rem; font-weight: 700; padding: 1px 6px; border-radius: 20px; }
  .filter-btn.active .filter-count { background: rgba(255,255,255,0.25); }

  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem; }

  .ver-todos { text-align: center; margin-top: 1.5rem; }
  .ver-todos a { font-size: 0.875rem; font-weight: 600; color: var(--blue); }

  /* Carrossel */
  .carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .carousel-track-outer {
    flex: 1;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: 1.25rem;
    transition: transform 0.35s ease;
  }

  .carousel-card {
    flex: 0 0 calc((100% - 2 * 1.25rem) / 3);
    min-width: 0;
  }

  .carousel-btn {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 1.375rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text);
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-btn:hover:not(:disabled) {
    border-color: var(--blue);
    color: var(--blue);
    background: var(--blue-light);
  }

  .carousel-btn:disabled { opacity: 0.3; cursor: default; }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.375rem;
    margin-top: 1rem;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--border);
    cursor: pointer;
    transition: background 0.15s, transform 0.15s;
    padding: 0;
  }

  .carousel-dot.active {
    background: var(--blue);
    transform: scale(1.25);
  }

  @media (max-width: 1023px) {
    .carousel-card { flex: 0 0 calc((100% - 1.25rem) / 2); }
  }

  @media (max-width: 639px) {
    .carousel-card { flex: 0 0 100%; }
    .carousel-btn { width: 32px; height: 32px; font-size: 1.125rem; }
  }
</style>
