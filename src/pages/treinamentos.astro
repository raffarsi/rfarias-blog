---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Treinamentos — rfarias" description="Cursos, simulados e material de apoio para certificações Microsoft.">
  <div class="container treinamentos">
    <div class="treinamentos-header">
      <h1>Treinamentos</h1>
      <p>Material de apoio, simulados gamificados e recursos para quem está se preparando para certificações Microsoft ou quer aprender Cloud e IA na prática.</p>
    </div>

    <!-- AZ-900 Card -->
    <section class="course-card featured">
      <div class="course-badge">Disponível</div>
      <div class="course-content">
        <h2>AZ-900: Microsoft Azure Fundamentals</h2>
        <p class="course-description">
          Plataforma de simulados gamificada com banco de questões, sistema de XP e níveis,
          conquistas temáticas e ranking entre alunos. Ideal para quem está se preparando
          para a certificação de entrada do Azure.
        </p>
        <div class="course-features">
          <div class="feature">
            <span class="feature-icon">📝</span>
            <div>
              <strong>Banco de questões</strong>
              <p>Questões organizadas por domínio do exame com diferentes níveis de dificuldade</p>
            </div>
          </div>
          <div class="feature">
            <span class="feature-icon">🎮</span>
            <div>
              <strong>Gamificação</strong>
              <p>XP, níveis, streaks e conquistas temáticas para manter a motivação</p>
            </div>
          </div>
          <div class="feature">
            <span class="feature-icon">🏆</span>
            <div>
              <strong>Ranking</strong>
              <p>Competição saudável entre alunos da turma</p>
            </div>
          </div>
          <div class="feature">
            <span class="feature-icon">🧪</span>
            <div>
              <strong>Laboratórios</strong>
              <p>Exercícios práticos guiados no portal do Azure</p>
            </div>
          </div>
        </div>
        <a href="https://raffarsi.github.io/Plataforma-treinamento-AZ/" target="_blank" rel="noopener" class="course-cta">
          Acessar plataforma
        </a>
      </div>
    </section>

    <!-- Coming soon -->
    <section class="coming-soon">
      <h2>Em breve</h2>
      <div class="coming-grid">
        <div class="coming-card">
          <span class="coming-icon">☁️</span>
          <h3>AZ-104: Azure Administrator</h3>
          <p>Simulados e laboratórios para a certificação de administrador Azure.</p>
          <span class="coming-badge">Em desenvolvimento</span>
        </div>
        <div class="coming-card">
          <span class="coming-icon">🤖</span>
          <h3>AI-900: Azure AI Fundamentals</h3>
          <p>Preparação para a certificação de fundamentos de IA no Azure.</p>
          <span class="coming-badge">Planejado</span>
        </div>
        <div class="coming-card">
          <span class="coming-icon">📊</span>
          <h3>MS Project: Gestão de Projetos</h3>
          <p>Material de apoio do curso ministrado no Senac.</p>
          <span class="coming-badge">Planejado</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .treinamentos {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .treinamentos-header {
    margin-bottom: 2.5rem;
  }

  .treinamentos-header h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .treinamentos-header p {
    color: var(--text-muted);
    font-size: 0.9375rem;
    max-width: 620px;
  }

  .course-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: 2rem;
    position: relative;
    margin-bottom: 3rem;
  }

  .course-card.featured {
    border-color: var(--blue);
    box-shadow: 0 2px 12px rgba(26, 86, 219, 0.08);
  }

  .course-badge {
    position: absolute;
    top: -10px;
    right: 20px;
    background: var(--blue);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 14px;
    border-radius: 20px;
  }

  .course-content h2 {
    font-size: 1.375rem;
    margin-bottom: 0.75rem;
  }

  .course-description {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 600px;
  }

  .course-features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .feature {
    display: flex;
    gap: 0.75rem;
  }

  .feature-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .feature strong {
    display: block;
    font-size: 0.875rem;
    margin-bottom: 0.2rem;
  }

  .feature p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .course-cta {
    display: inline-block;
    background: var(--blue);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.625rem 1.5rem;
    border-radius: 8px;
    transition: opacity 0.15s;
  }

  .course-cta:hover {
    opacity: 0.9;
  }

  .coming-soon h2 {
    font-size: 1.375rem;
    margin-bottom: 1.25rem;
  }

  .coming-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .coming-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    background: var(--surface);
  }

  .coming-icon {
    font-size: 1.75rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .coming-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .coming-card p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .coming-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 20px;
  }

  @media (max-width: 768px) {
    .course-features { grid-template-columns: 1fr; }
    .coming-grid { grid-template-columns: 1fr; }
  }
</style>
