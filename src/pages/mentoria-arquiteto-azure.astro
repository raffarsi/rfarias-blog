---
import SEO from '../components/SEO.astro';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mentoria Arquiteto Azure: Plataforma Corporativa de IA Generativa | rfarias</title>
  <meta name="description" content="Aula técnica sobre Plataforma Corporativa de IA Generativa Baseada em Agentes Inteligentes, apresentada na Mentoria Arquiteto Azure do MVP Guilherme Maia." />
  <SEO
    title="Mentoria Arquiteto Azure: Plataforma Corporativa de IA Generativa"
    description="Aula técnica sobre Plataforma Corporativa de IA Generativa Baseada em Agentes Inteligentes, apresentada na Mentoria Arquiteto Azure do MVP Guilherme Maia."
    image="/mentoria-azure-ia.jpeg"
  />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #05071A;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    .container {
      max-width: 960px;
