---
import SEO from '../components/SEO.astro';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <SEO
    title="Senac Osasco — Aula Prática de Infraestrutura e Networking no Azure"
    description="Treinamento presencial de Infraestrutura e Networking no Azure ministrado no Senac Osasco. Prof. Rafael Farias em sala de aula. Outubro de 2025."
    image="/senac-aula-4-professor.jpeg"
  />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #05071A; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; }
    .container { max-width: 960px; width: 100%; }
    img { width: 100%; height: auto; display: block; border-radius: 12px; border: 1px solid rgba(0,170,255,0.2); }
  </style>
</head>
<body>
  <div class="container">
    <img src="/senac-aula-4-professor.jpeg" alt="Aula prática de Infraestrutura e Networking no Azure — Senac Osasco, outubro de 2025. Prof. Rafael Farias." />
  </div>
</body>
</html>
