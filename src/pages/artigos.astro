  { slug: 'az900-06-custos-sla', title: 'AZ-900 na prática [6] — Custos, SLA e ciclo de vida de serviços', category: 'Azure', tag: 'azure' as const, date: '21 Mar 2026', readTime: '8 min', excerpt: 'Como calcular custos no Azure, entender SLAs e o ciclo de vida de serviços.' },
