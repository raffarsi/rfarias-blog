  { slug: 'ai901-04-ia-conversacional', title: 'AI-901 na prática [4] — IA conversacional e agentes', category: 'IA', tag: 'ia' as const, date: '4 Abr 2026', readTime: '8 min', excerpt: 'Azure Bot Service, Copilot Studio e como criar assistentes virtuais inteligentes.' },
  { slug: 'ai901-03-linguagem-ia-generativa', title: 'AI-901 na prática [3] — Linguagem natural e IA Generativa', category: 'IA', tag: 'ia' as const, date: '31 Mar 2026', readTime: '10 min', excerpt: 'NLP, Azure Language Service, Azure OpenAI e os fundamentos de IA Generativa.' },
  { slug: 'ai901-02-azure-ai-services', title: 'AI-901 na prática [2] — Azure AI Services: visão e fala', category: 'IA', tag: 'ia' as const, date: '28 Mar 2026', readTime: '9 min', excerpt: 'Azure Computer Vision, Custom Vision, Face API e Azure Speech Services na prática.' },
