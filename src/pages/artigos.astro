---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = [
  {
    slug: 'private-endpoints-azure',
    title: 'Como configurar Private Endpoints no Azure sem perder o acesso ao portal',
    category: 'Azure',
    tag: 'tech' as const,
    date: '27 Ago 2026',
    readTime: '8 min',
    excerpt: 'Passo a passo com as armadilhas de DNS que a documentação não destaca.',
  },
  {
    slug: 'aula-ms-project',
    title: 'O que aprendi dando aula de MS Project pra quem nunca viu gestão de projetos',
    category: 'Carreira',
    tag: 'carreira' as const,
    date: '23 Ago 2026',
    readTime: '5 min',
    excerpt: 'Reflexões sobre adaptar o plano de aula para alunos sem experiência em gestão.',
  },
  {
    slug: 'azure-ai-foundry',
    title: 'Azure AI Foundry: criando seu primeiro projeto de IA Generativa',
    category: 'IA',
    tag: 'tech' as const,
    date: '20 Ago 2026',
    readTime: '12 min',
    excerpt: 'Guia prático para montar uma PoC de chatbot com RAG no Azure AI Foundry.',
  },
  {
    slug: '17-anos-mesma-empresa',
    title: '17 anos na mesma empresa — o que me fez ficar (e o que quase me fez sair)',
    category: 'Carreira',
    tag: 'carreira' as const,
    date: '16 Ago 2026',
    readTime: '6 min',
    excerpt: 'Longevidade em uma empresa não é inércia. Decisões conscientes em cada fase.',
  },
  {
    slug: 'nsg-vs-asg',
    title: 'Network Security Groups vs Application Security Groups: quando usar cada um',
    category: 'Azure',
    tag: 'tech' as const,
    date: '13 Ago 2026',
    readTime: '10 min',
    excerpt: 'NSG e ASG parecem redundantes, mas resolvem problemas diferentes.',
  },
  {
    slug: 'simulado-gamificado-az900',
    title: 'Como montei um simulado gamificado de AZ-900 para meus alunos',
    category: 'Carreira',
    tag: 'carreira' as const,
    date: '9 Ago 2026',
    readTime: '7 min',
    excerpt: 'Plataforma com banco de questões, XP, ranking e conquistas para estudo do AZ-900.',
  },
];
---

<BaseLayout title="Artigos — rfarias" description="Artigos sobre Azure, Cloud, IA Generativa, docência e carreira em tecnologia.">
  <div class="container artigos">
    <div class="artigos-header">
      <h1>Artigos</h1>
      <p>Tecnologia, Cloud, IA e os bastidores de equilibrar carreira corporativa com docência.</p>
    </div>

    <div class="filters" id="filters">
      <button class="filter-btn active" data-filter="todos">Todos</button>
      <button class="filter-btn" data-filter="tech">Tecnologia</button>
      <button class="filter-btn" data-filter="carreira">Carreira</button>
    </div>

    <section class="post-grid" id="post-grid">
      {posts.map(post => (
        <div class="post-item" data-tag={post.tag}>
          <PostCard {...post} />
        </div>
      ))}
    </section>
  </div>

  <script is:inline>
    document.getElementById('filters').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-filter]');
      if (!btn) return;

      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.dataset.filter;
      document.querySelectorAll('.post-item').forEach(item => {
        item.style.display = (filter === 'todos' || item.dataset.tag === filter) ? '' : 'none';
      });
    });
  </script>
</BaseLayout>

<style>
  .artigos { padding-top: 2rem; padding-bottom: 2rem; }

  .artigos-header { margin-bottom: 2rem; }
  .artigos-header h1 { font-size: 1.75rem; margin-bottom: 0.5rem; }
  .artigos-header p { color: var(--text-muted); font-size: 0.9375rem; max-width: 560px; }

  .filters {
    display: flex;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
  }

  .filter-btn {
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: var(--font-sans);
    padding: 0.375rem 1rem;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter-btn:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .filter-btn.active {
    background: var(--blue);
    color: #fff;
    border-color: var(--blue);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .post-grid { grid-template-columns: 1fr; }
  }
</style>
