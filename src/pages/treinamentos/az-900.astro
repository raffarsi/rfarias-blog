---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="AZ-900 — Treinamentos — rfarias" description="Simulados, banco de questões e gamificação para a certificação Microsoft Azure Fundamentals.">

  <script is:inline>
    // Inject az900 CSS before page renders
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/css/az900.css';
    document.head.appendChild(link);
  </script>

  <div class="az-breadcrumb">
    <div class="container">
      <a href="/treinamentos">← Treinamentos</a>
      <span class="sep">/</span>
      <span class="current">AZ-900 · Azure Fundamentals</span>
    </div>
  </div>

  <!-- Platform header with nav -->
  <header id="app-header">
    <div class="container" style="display:flex;align-items:center;flex-wrap:wrap;gap:0.5rem;">
      <nav class="app-nav" aria-label="Navegação da plataforma">
        <button class="nav-btn" data-screen="dashboard">🏠 Início</button>
        <button class="nav-btn" data-screen="bank">📖 Banco de Questões</button>
        <button class="nav-btn" data-screen="simulado">📝 Simulado</button>
        <button class="nav-btn" data-screen="games">🎮 Jogos</button>
        <button class="nav-btn" data-screen="labs">🧪 Laboratórios</button>
        <button class="nav-btn" data-screen="history">📊 Histórico</button>
        <button class="nav-btn" data-screen="achievements">🏅 Conquistas</button>
        <button class="nav-btn" data-screen="ranking">🏆 Ranking</button>
        <button class="nav-btn" data-screen="erros">📋 Erros</button>
        <button class="nav-btn" data-screen="dominios">📊 Domínios</button>
        <button class="nav-btn" data-screen="flashcards">🃏 Flashcards</button>
        <button class="nav-btn" data-screen="oficial">🎓 Simulado Oficial</button>
        <button class="nav-btn" data-screen="plano">📅 Plano de Estudo</button>
        <button class="nav-btn" data-screen="relatorio">📤 Relatório</button>
        <button class="nav-btn" data-screen="ilabs">🔬 Labs Interativos</button>
      </nav>

      <div class="header-right">
        <div id="xp-indicator">
          <span id="xp-label">Nível 1 · 0/150 XP</span>
          <div id="xp-bar-outer" class="xp-bar-outer"><div id="xp-bar-fill" class="xp-bar-fill" style="width:0%"></div></div>
        </div>
        <span id="student-badge" class="student-badge"></span>
        <button id="switch-student-btn" class="btn-mini" title="Trocar aluno">🔄 Trocar aluno</button>
      </div>
    </div>
  </header>

  <!-- Main content - sections rendered by app.js -->
  <main id="app-main" class="container" style="padding-top:1.5rem;padding-bottom:2rem;min-height:60vh;">
    <section id="screen-landing" class="screen"></section>
    <section id="screen-azurehub" class="screen"></section>
    <section id="screen-cursoslivreshub" class="screen"></section>
    <section id="screen-login" class="screen"></section>
    <section id="screen-dashboard" class="screen"></section>
    <section id="screen-bank" class="screen"></section>
    <section id="screen-simulado" class="screen"></section>
    <section id="screen-games" class="screen"></section>
    <section id="screen-labs" class="screen"></section>
    <section id="screen-history" class="screen"></section>
    <section id="screen-achievements" class="screen"></section>
    <section id="screen-ranking" class="screen"></section>
    <section id="screen-erros" class="screen"></section>
    <section id="screen-dominios" class="screen"></section>
    <section id="screen-flashcards" class="screen"></section>
    <section id="screen-oficial" class="screen"></section>
    <section id="screen-plano" class="screen"></section>
    <section id="screen-relatorio" class="screen"></section>
    <section id="screen-ilabs" class="screen"></section>
  </main>

  <div id="toast-container" aria-live="polite"></div>

  <!-- Scripts -->
  <script src="/js/az900/article-links.js" is:inline></script>
  <script src="/js/az900/questions.js" is:inline></script>
  <script src="/js/az900/games.js" is:inline></script>
  <script src="/js/az900/labs.js" is:inline></script>
  <script src="/js/az900/app.js" is:inline></script>
  <script src="/js/az900/features.js" is:inline></script>
  <script src="/js/az900/features2.js" is:inline></script>
  <script src="/js/az900/features3.js" is:inline></script>
  <script src="/js/az900/init.js" is:inline></script>
</BaseLayout>

<style>
  /* Breadcrumb */
  .az-breadcrumb {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
    font-size: 0.8125rem;
  }
  .az-breadcrumb a { color: var(--blue); font-weight: 500; }
  .az-breadcrumb .sep { margin: 0 0.5rem; color: var(--border); }
  .az-breadcrumb .current { font-weight: 600; color: var(--text); }

  /* Make header sticky below blog nav */
  #app-header {
    position: sticky;
    top: 56px;
    z-index: 90;
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0;
  }

  /* Pre-auth: hide platform nav */
  :global(body.pre-auth) #app-header { display: none; }
</style>
