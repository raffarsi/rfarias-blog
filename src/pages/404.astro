---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada — rfarias">
  <div class="container not-found">
    <svg width="64" height="64" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" style="opacity: 0.3;">
      <circle cx="20" cy="8" r="4" fill="var(--text-muted)" />
      <circle cx="8" cy="28" r="4" fill="var(--text-muted)" />
      <circle cx="32" cy="28" r="4" fill="var(--text-muted)" />
      <circle cx="20" cy="22" r="3" fill="var(--text-muted)" />
      <line x1="20" y1="12" x2="20" y2="19" stroke="var(--text-muted)" stroke-width="2" />
      <line x1="17.5" y1="24" x2="11" y2="27" stroke="var(--text-muted)" stroke-width="2" />
      <line x1="22.5" y1="24" x2="29" y2="27" stroke="var(--text-muted)" stroke-width="2" />
    </svg>
    <h1>404</h1>
    <p>Essa página não existe — mas o blog tem bastante conteúdo para explorar.</p>
    <a href="/" class="back-link">Voltar ao início</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 60vh;
    gap: 1rem;
  }

  h1 {
    font-size: 4rem;
    color: var(--text-muted);
    opacity: 0.5;
  }

  p {
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 400px;
  }

  .back-link {
    display: inline-block;
    margin-top: 0.5rem;
    background: var(--blue);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    transition: opacity 0.15s;
  }

  .back-link:hover {
    opacity: 0.9;
  }
</style>
